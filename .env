# Environment configuration consumed by compose.yaml via ${VAR} substitution.
# Committed on purpose: it holds no real secrets, only local container defaults.

# ---- Resource Service database ----
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres

# ---- Song Service database ----
SONG_DB_NAME=song_db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres

# ---- JDBC URLs (services reach the databases by compose service name) ----
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_db
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_db

# ---- Inter-service URL (resource-service -> song-service by service name) ----
SONG_SERVICE_URL=http://song-service:8082
